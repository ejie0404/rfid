{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:smartgate:edge:v1:heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edge_id",
    "organization_id",
    "reported_at",
    "config_version",
    "pending_events",
    "hardware_mode"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "edge_id": {
      "type": "string",
      "format": "uuid"
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "config_version": {
      "type": "integer",
      "minimum": 0
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "software_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "pending_events": {
      "type": "integer",
      "minimum": 0
    },
    "hardware_mode": {
      "enum": ["simulator", "hikvision"]
    }
  }
}
