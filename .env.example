# Local-only demo configuration. Copy to .env in the repository root.
SMARTGATE_DEMO=true
PORT=4100
# Relative paths are resolved from the platform root for every command.
SMARTGATE_DATA_DIR=.data/postgres

# Optional PostgreSQL for local development. Keep migration and API credentials separate.
# DATABASE_URL=postgresql://smartgate_app:YOUR_PASSWORD@127.0.0.1:5432/smartgate

# Public browser settings belong in each app's ignored .env.local file, not this API file.
# NEXT_PUBLIC_SMARTGATE_API_URL=http://127.0.0.1:4100
# NEXT_PUBLIC_SMARTGATE_EDGE_URL=http://127.0.0.1:4200
