{
  "name": "@smartgate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "dev:move-out-worker": "node --env-file-if-exists=../../.env --import tsx src/move-out-worker-main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:move-out-worker": "node dist/move-out-worker-main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@smartgate/contracts": "*",
    "@smartgate/permissions": "*",
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@electric-sql/pglite": "0.5.8",
    "fastify": "5.12.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@types/pg": "8.23.1"
  }
}
